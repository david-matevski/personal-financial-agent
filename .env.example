# Copy to .env and fill in. Never commit .env.

# --- Database ---
# PostgreSQL connection string
FINAGENT_DATABASE_URL=postgresql+psycopg://finagent:finagent@localhost:5432/finagent

# --- Logging ---
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
FINAGENT_LOG_LEVEL=INFO

# --- AI extraction (Anthropic) ---
# API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Claude model used to extract transactions from statements
FINAGENT_EXTRACTION_MODEL=claude-opus-5
