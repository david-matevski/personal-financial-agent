# Copy to .env and fill in. Never commit .env.

# --- Database ---
# PostgreSQL connection string
FINAGENT_DATABASE_URL=postgresql+psycopg://finagent:finagent@localhost:5432/finagent

# --- Logging ---
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
FINAGENT_LOG_LEVEL=INFO

# --- AI extraction (Anthropic) ---
# API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Claude model used to extract transactions from statements
FINAGENT_EXTRACTION_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max
FINAGENT_EXTRACTION_EFFORT=high

# --- API auth ---
# Bearer token required by every endpoint except GET /health. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FINAGENT_API_TOKEN=

# --- Background worker ---
# Whether this process runs the async upload-processing worker thread
# (drains POST /uploads' queue). Leave true for a normal deployment; set
# false only for a process that should serve the API without processing
# uploads.
FINAGENT_RUN_WORKER=true
