# --- Financial data: never commit (public repo) ---
data/
statements/
uploads/
exports/
# Statements & exports
*.pdf
*.xls
*.xlsx
*.csv
*.ofx
*.qfx
*.qbo
# Scanned / photographed statements (OCR input)
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.heic
*.webp
