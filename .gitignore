*.dump
*.backup
*.bak
*.sqlite
*.sqlite3
*.db
# Archives often bundle statements
*.zip
*.7z
# Synthetic test fixtures are the only exception
!tests/fixtures/**

# --- Logs (may echo parsed data) ---
*.log
logs/

